# 이 파일을 .env로 복사해서 실제 값 채우기 (.env는 git에 올라가지 않음)

OPENAI_API_KEY=

# DR(PersonalDailyReport)의 Neon Postgres - 읽기 전용 role 권장 (README 참고)
DR_DATABASE_URL=

# 새로 만든 인스타그램 계정의 토큰/ID (AInstagram 계정과 다름)
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# 알림용 - AInstagram과 같은 봇/채팅을 써도 된다. 비워두면 알림 없이 동작
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 이미지 호스팅 - AInstagram과 같은 버킷을 써도 된다 (config.yaml의 storage_prefix로 경로 분리)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
